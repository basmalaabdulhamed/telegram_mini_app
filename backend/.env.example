# Environment Variables — Backend

# Telegram Bot Token (get from @BotFather)
BOT_TOKEN=your_telegram_bot_token_here

# Server port
PORT=3001

# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/cafe_bot

# Frontend URL (your Vercel deployment or local tunnel URL)
WEBAPP_URL=https://your-frontend-url.vercel.app

# Admin panel password (for /admin route)
ADMIN_PASSWORD=changeme123

# Staff panel PIN (for /staff route)
STAFF_PIN=1234

# Paymob (Phase 5 — leave empty until you have keys)
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID=
PAYMOB_IFRAME_ID=
PAYMOB_HMAC_SECRET=
